{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3SyncToBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::josh-personal-site-1"
    },
    {
      "Sid": "S3ReadWriteObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:PutObjectAcl"],
      "Resource": "arn:aws:s3:::josh-personal-site-1/*"
    },
    {
      "Sid": "CloudFrontInvalidate",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation",
        "cloudfront:ListInvalidations",
        "cloudfront:GetDistribution"
      ],
      "Resource": "arn:aws:cloudfront::545095759709:distribution/E3LDS3FK17E3JF"
    },
    {
      "Sid": "LambdaDeployAdminFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:ListVersionsByFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:PublishVersion",
        "lambda:GetFunctionUrlConfig",
        "lambda:UpdateFunctionUrlConfig"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:545095759709:function:admin-login",
        "arn:aws:lambda:us-east-1:545095759709:function:admin-messages"
      ]
    },
    {
      "Sid": "LambdaDiscovery",
      "Effect": "Allow",
      "Action": ["lambda:ListFunctions", "lambda:GetAccountSettings"],
      "Resource": "*"
    },
    {
      "Sid": "PassLambdaExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::545095759709:role/REPLACE_WITH_LAMBDA_EXEC_ROLE",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "lambda.amazonaws.com" }
      }
    },
    {
      "Sid": "ApiGatewayManageAdminApi",
      "Effect": "Allow",
      "Action": ["apigateway:GET", "apigateway:POST", "apigateway:PUT", "apigateway:PATCH", "apigateway:DELETE"],
      "Resource": [
        "arn:aws:apigateway:us-east-1::/apis/nk1byjfld0",
        "arn:aws:apigateway:us-east-1::/apis/nk1byjfld0/*"
      ]
    },
    {
      "Sid": "CloudWatchLogsReadAdminFunctions",
      "Effect": "Allow",
      "Action": [
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "logs:DescribeLogStreams",
        "logs:StartQuery",
        "logs:StopQuery",
        "logs:GetQueryResults"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:545095759709:log-group:/aws/lambda/admin-login:*",
        "arn:aws:logs:us-east-1:545095759709:log-group:/aws/lambda/admin-messages:*"
      ]
    },
    {
      "Sid": "CloudWatchLogsDescribe",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogGroups"],
      "Resource": "*"
    },
    {
      "Sid": "DynamoDBMessagesTableOperational",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeTable",
        "dynamodb:Scan",
        "dynamodb:Query",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:545095759709:table/REPLACE_WITH_MESSAGES_TABLE",
        "arn:aws:dynamodb:us-east-1:545095759709:table/REPLACE_WITH_MESSAGES_TABLE/index/*"
      ]
    },
    {
      "Sid": "WafManageAdminWebAcl",
      "Effect": "Allow",
      "Action": [
        "wafv2:GetWebACL",
        "wafv2:UpdateWebACL",
        "wafv2:GetRuleGroup",
        "wafv2:ListWebACLs",
        "wafv2:GetLoggingConfiguration"
      ],
      "Resource": [
        "arn:aws:wafv2:us-east-1:545095759709:regional/webacl/REPLACE_WITH_WAF_ACL_NAME/REPLACE_WITH_WAF_ACL_ID"
      ]
    }
  ]
}
