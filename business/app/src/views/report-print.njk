<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Accessibility report — {{ vm.site.name }}</title>
<style>
  :root { --accent: {{ vm.branding.accentColor }}; }
  * { box-sizing: border-box; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
         color: #0f172a; margin: 0; font-size: 12.5px; line-height: 1.55; }
  a { color: var(--accent); text-decoration: none; }
  h1 { font-size: 24px; margin: 0 0 4px; }
  h2 { font-size: 17px; margin: 26px 0 8px; border-bottom: 2px solid var(--accent); padding-bottom: 4px; }
  h3 { font-size: 14px; margin: 18px 0 6px; }
  p { margin: 5px 0; }
  .muted { color: #64748b; }
  .cover { padding: 26px 0 8px; border-bottom: 4px solid var(--accent); margin-bottom: 18px;
           display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .cover img.logo { max-height: 56px; max-width: 190px; object-fit: contain; }
  .agency-name { font-size: 15px; font-weight: 700; color: var(--accent); }
  .grid { display: flex; gap: 8px; flex-wrap: wrap; margin: 12px 0; }
  .stat { flex: 1 1 90px; border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px; text-align: center; }
  .stat .num { display: block; font-size: 20px; font-weight: 800; }
  .stat .lbl { font-size: 9.5px; color: #64748b; text-transform: uppercase; letter-spacing: .05em; }
  .badge { display: inline-block; font-size: 9.5px; font-weight: 700; padding: 1px 8px; border-radius: 999px; vertical-align: middle; }
  .badge-critical { background: #fef2f2; color: #b91c1c; }
  .badge-serious  { background: #fff7ed; color: #c2410c; }
  .badge-moderate { background: #fffbeb; color: #b45309; }
  .badge-minor    { background: #f1f5f9; color: #64748b; }
  .grade-A { color: #047857; } .grade-B { color: #4d7c0f; } .grade-C { color: #b45309; }
  .grade-D { color: #c2410c; } .grade-F { color: #b91c1c; }
  table { width: 100%; border-collapse: collapse; font-size: 11.5px; margin: 8px 0; }
  th { text-align: left; color: #64748b; font-size: 9.5px; text-transform: uppercase; letter-spacing: .04em;
       border-bottom: 1px solid #e2e8f0; padding: 4px 6px; }
  td { border-bottom: 1px solid #eef2f7; padding: 5px 6px; vertical-align: top; word-break: break-word; }
  .rule { border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 12px; margin: 0 0 10px; page-break-inside: avoid; }
  .rule h4 { margin: 0 0 4px; font-size: 13px; }
  .pages-list { margin: 6px 0 0; padding-left: 16px; }
  .pages-list li { margin: 2px 0; }
  .honesty { background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 10px 12px; margin: 14px 0; }
  .footer-note { margin-top: 22px; padding-top: 8px; border-top: 1px solid #e2e8f0; font-size: 9.5px; color: #64748b; }
  .verdict { font-size: 13.5px; }
</style>
</head>
<body>

<div class="cover">
  <div>
    <div class="agency-name">{{ vm.branding.agencyName }}</div>
    <h1>Website Accessibility Report</h1>
    <p class="muted">Prepared for <strong>{{ vm.site.name }}</strong> ({{ vm.site.origin | hostname }})</p>
    <p class="muted">Scan date: {{ vm.scan.finished_at | dateonly }}</p>
  </div>
  {% if logoDataUri %}<img class="logo" src="{{ logoDataUri }}" alt="{{ vm.branding.agencyName }} logo">{% endif %}
</div>

<h2>Executive summary</h2>
<p class="verdict">{{ vm.summary.verdictLine }}</p>
<div class="grid">
  <div class="stat"><span class="num grade-{{ vm.summary.grade }}">{{ vm.summary.grade }}</span><span class="lbl">Grade</span></div>
  <div class="stat"><span class="num">{{ vm.summary.score }}</span><span class="lbl">Score / 100</span></div>
  <div class="stat"><span class="num">{{ vm.summary.counts.critical }}</span><span class="lbl">Critical</span></div>
  <div class="stat"><span class="num">{{ vm.summary.counts.serious }}</span><span class="lbl">Serious</span></div>
  <div class="stat"><span class="num">{{ vm.summary.counts.moderate }}</span><span class="lbl">Moderate</span></div>
  <div class="stat"><span class="num">{{ vm.summary.counts.minor }}</span><span class="lbl">Minor</span></div>
</div>
<p class="muted">{{ vm.summary.pagesOk }} page{% if vm.summary.pagesOk != 1 %}s{% endif %} checked against WCAG 2.1 A/AA automated rules{% if vm.summary.pagesFailed > 0 %} · {{ vm.summary.pagesFailed }} page{% if vm.summary.pagesFailed != 1 %}s{% endif %} could not be loaded (listed at the end){% endif %}.</p>

{% if vm.topFixes.length > 0 %}
<h2>Where to start — highest-impact fixes</h2>
<ol>
  {% for fix in vm.topFixes %}
  <li>
    <strong>{{ fix.title }}</strong> <span class="badge badge-{{ fix.impact }}">{{ fix.impact }}</span><br>
    <span class="muted">{{ fix.totalCount }} instance{% if fix.totalCount != 1 %}s{% endif %} across {{ fix.pages.length }} page{% if fix.pages.length != 1 %}s{% endif %}.</span>
    {{ fix.fix }}
  </li>
  {% endfor %}
</ol>
{% endif %}

<div class="honesty">
  <strong>Scope of this report.</strong> These findings come from automated checks, which
  reliably detect roughly a third of accessibility issues — the mechanical ones such as
  missing image descriptions, low color contrast, and unlabeled form fields. A clean automated
  result is meaningful progress, not a certification. For complete coverage, pair these fixes
  with a manual review of key user journeys. This report is informational and is not legal advice.
</div>

<h2>Findings in detail</h2>
{% if vm.summary.totalIssues == 0 %}
  <p>No issues were detected by the automated checks on the pages scanned.</p>
{% endif %}
{% for impactBlock in vm.groupsByImpact %}
  <h3 style="text-transform:capitalize">{{ impactBlock.impact }} ({{ impactBlock.groups | length }} issue type{% if impactBlock.groups | length != 1 %}s{% endif %})</h3>
  {% for group in impactBlock.groups %}
  <div class="rule">
    <h4>{{ group.title }} <span class="badge badge-{{ group.impact }}">{{ group.impact }}</span></h4>
    <p><strong>Why it matters:</strong> {{ group.why }}</p>
    <p><strong>How to fix it:</strong> {{ group.fix }}</p>
    {% if group.wcagTags.length > 0 %}<p class="muted">WCAG reference: {{ group.wcagTags | join(', ') }}</p>{% endif %}
    <ul class="pages-list">
      {% for page in group.pages %}
      <li>{{ page.url | pathOf }} — {{ page.count }} instance{% if page.count != 1 %}s{% endif %}</li>
      {% endfor %}
    </ul>
  </div>
  {% endfor %}
{% endfor %}

<h2>Pages checked</h2>
<table>
  <thead><tr><th>Page</th><th>Score</th><th>Issues found</th></tr></thead>
  <tbody>
    {% for page in vm.okPages %}
    <tr><td>{{ page.url | pathOf }}</td><td>{{ page.score }}</td><td>{{ page.issueCount }}</td></tr>
    {% endfor %}
  </tbody>
</table>

{% if vm.failedPages.length > 0 %}
<h2>Pages that could not be checked</h2>
<table>
  <thead><tr><th>Page</th><th>Reason</th></tr></thead>
  <tbody>
    {% for page in vm.failedPages %}
    <tr><td>{{ page.url | pathOf }}</td><td>{{ page.reason }}</td></tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

<div class="footer-note">
  Generated {{ vm.generatedAt | datetime }} · Engine: axe-core (WCAG 2.1 A/AA rule set) in a real browser ·
  Scoring: 100 minus weighted penalties per issue type (critical 12, serious 6, moderate 2, minor 0.5;
  repeat instances discounted), averaged across pages.
  {% if not forPdf %}· Prepared with {{ brand }}{% endif %}
</div>

</body>
</html>
