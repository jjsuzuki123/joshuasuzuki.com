{% extends "layout.njk" %}
{% block content %}
<div class="card" style="max-width:440px;margin:2rem auto">
  <h1>Log in</h1>
  {% if error %}<div class="form-error" role="alert">{{ error }}</div>{% endif %}
  <form method="post" action="/login">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    {% if next %}<input type="hidden" name="next" value="{{ next }}">{% endif %}
    <label for="email">Email</label>
    <input type="email" id="email" name="email" required autocomplete="email" value="{{ email or '' }}">
    <label for="password">Password</label>
    <input type="password" id="password" name="password" required autocomplete="current-password">
    <p><button class="btn btn-primary" type="submit" style="width:100%">Log in</button></p>
  </form>
  <p class="muted"><a href="/forgot-password">Forgot your password?</a></p>
  <p class="muted">New here? <a href="/signup">Start a free trial</a>.</p>
</div>
{% endblock %}
