{% extends "layout.njk" %}
{% block content %}
<div class="card" style="max-width:440px;margin:2rem auto">
  <h1>Start your free trial</h1>
  <p class="muted">7 days, full features, no credit card.</p>
  {% if error %}<div class="form-error" role="alert">{{ error }}</div>{% endif %}
  <form method="post" action="/signup">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <label for="email">Work email</label>
    <input type="email" id="email" name="email" required autocomplete="email" value="{{ email or '' }}">
    <label for="password">Password</label>
    <input type="password" id="password" name="password" required minlength="10" autocomplete="new-password">
    <p class="field-help">At least 10 characters — a short sentence works well.</p>
    <p><button class="btn btn-primary" type="submit" style="width:100%">Create account</button></p>
  </form>
  <p class="muted">Already have an account? <a href="/login">Log in</a>.</p>
  <p class="muted" style="font-size:.85rem">By creating an account you agree to the <a href="/legal/terms">Terms</a> and <a href="/legal/privacy">Privacy Policy</a>.</p>
</div>
{% endblock %}
