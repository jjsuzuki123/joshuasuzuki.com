{% extends "layout.njk" %}
{% block content %}
<div class="card" style="max-width:440px;margin:2rem auto">
  <h1>Reset your password</h1>
  {% if error %}<div class="form-error" role="alert">{{ error }}</div>{% endif %}
  {% if sent %}
    <div class="flash flash-success" role="status">
      If an account exists for {{ email }}, a reset link is on its way. It's valid for 1 hour —
      check your spam folder if it doesn't arrive.
    </div>
    <p><a href="/login">Back to login</a></p>
  {% elif manualMode %}
    <div class="flash flash-error" role="status">
      Automatic reset emails aren't enabled on this installation yet. Email
      <a href="mailto:{{ supportEmail }}">{{ supportEmail }}</a> from your account address and
      we'll reset it for you promptly.
    </div>
    <p><a href="/login">Back to login</a></p>
  {% else %}
    <p class="muted">Enter your account email and we'll send a reset link.</p>
    <form method="post" action="/forgot-password">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required autocomplete="email">
      <p><button class="btn btn-primary" type="submit" style="width:100%">Send reset link</button></p>
    </form>
    <p class="muted"><a href="/login">Back to login</a></p>
  {% endif %}
</div>
{% endblock %}
