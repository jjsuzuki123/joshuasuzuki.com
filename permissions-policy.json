{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RosterLabDescribeBootstrap",
      "Effect": "Allow",
      "Action": ["cloudformation:DescribeStacks"],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:545095759709:stack/rosterlab-fantasy-import-bootstrap/*",
        "arn:aws:cloudformation:us-east-1:545095759709:stack/aispend-bootstrap/*"
      ]
    },
    {
      "Sid": "S3SyncToBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation","s3:ListBucket"],
      "Resource": "arn:aws:s3:::josh-personal-site-1"
    },
    {
      "Sid": "S3ReadWriteObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject","s3:PutObject","s3:DeleteObject"],
      "Resource": "arn:aws:s3:::josh-personal-site-1/*"
    },
    {
      "Sid": "RosterLabArtifactBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation","s3:ListBucket"],
      "Resource": "arn:aws:s3:::rosterlab-deploy-artifacts-545095759709-us-east-1"
    },
    {
      "Sid": "RosterLabArtifactObjects",
      "Effect": "Allow",
      "Action": ["s3:DeleteObject","s3:GetObject","s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::rosterlab-deploy-artifacts-545095759709-us-east-1/rosterlab/*",
        "arn:aws:s3:::rosterlab-deploy-artifacts-545095759709-us-east-1/aispend/*"
      ]
    },
    {
      "Sid": "CloudFrontInvalidate",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation","cloudfront:GetInvalidation","cloudfront:ListInvalidations"],
      "Resource": "arn:aws:cloudfront::545095759709:distribution/E3LDS3FK17E3JF"
    },
    {
      "Sid": "RosterLabCloudFormation",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:DescribeStacks",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:ListStackResources"
      ],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:545095759709:stack/rosterlab-fantasy-import-*/*",
        "arn:aws:cloudformation:us-east-1:545095759709:stack/rosterlab-fantasy-insights-*/*",
        "arn:aws:cloudformation:us-east-1:545095759709:stack/aispend-*/*"
      ]
    },
    {
      "Sid": "RosterLabSamTransform",
      "Effect": "Allow",
      "Action": ["cloudformation:CreateChangeSet"],
      "Resource": "arn:aws:cloudformation:us-east-1:aws:transform/Serverless-2016-10-31"
    },
    {
      "Sid": "RosterLabLambdaDeployment",
      "Effect": "Allow",
      "Action": [
        "lambda:AddPermission",
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:DeleteFunctionConcurrency",
        "lambda:GetFunction",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionConcurrency",
        "lambda:GetFunctionRecursionConfig",
        "lambda:GetFunctionScalingConfig",
        "lambda:GetRuntimeManagementConfig",
        "lambda:GetPolicy",
        "lambda:ListTags",
        "lambda:PutFunctionConcurrency",
        "lambda:RemovePermission",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:545095759709:function:rosterlab-espn-import-*",
        "arn:aws:lambda:us-east-1:545095759709:function:rosterlab-fantasy-insights-*",
        "arn:aws:lambda:us-east-1:545095759709:function:aispend-*"
      ]
    },
    {
      "Sid": "RosterLabLambdaEventSources",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateEventSourceMapping",
        "lambda:DeleteEventSourceMapping",
        "lambda:UpdateEventSourceMapping"
      ],
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "lambda:FunctionArn": [
            "arn:aws:lambda:us-east-1:545095759709:function:rosterlab-fantasy-insights-*",
            "arn:aws:lambda:us-east-1:545095759709:function:aispend-*"
          ]
        }
      }
    },
    {
      "Sid": "RosterLabReadAndTagLambdaEventSources",
      "Effect": "Allow",
      "Action": [
        "lambda:GetEventSourceMapping",
        "lambda:ListTags",
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": "arn:aws:lambda:us-east-1:545095759709:event-source-mapping:*"
    },
    {
      "Sid": "RosterLabListLambdaEventSources",
      "Effect": "Allow",
      "Action": ["lambda:ListEventSourceMappings"],
      "Resource": "*"
    },
    {
      "Sid": "RosterLabApiGatewayDeployment",
      "Effect": "Allow",
      "Action": "apigateway:*",
      "Resource": [
        "arn:aws:apigateway:us-east-1::/apis",
        "arn:aws:apigateway:us-east-1::/apis/*",
        "arn:aws:apigateway:us-east-1::/tags/*"
      ]
    },
    {
      "Sid": "RosterLabExecutionRoleDeployment",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": [
        "arn:aws:iam::545095759709:role/rosterlab-espn-import-production",
        "arn:aws:iam::545095759709:role/rosterlab-fantasy-insights-production-api",
        "arn:aws:iam::545095759709:role/rosterlab-fantasy-insights-production-worker",
        "arn:aws:iam::545095759709:role/aispend-production-api",
        "arn:aws:iam::545095759709:role/aispend-production-worker"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "RosterLabDescribeFirecrawlSecret",
      "Effect": "Allow",
      "Action": ["secretsmanager:DescribeSecret"],
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:545095759709:secret:rosterlab/firecrawl/production-*",
        "arn:aws:secretsmanager:us-east-1:545095759709:secret:aispend/github/production-*",
        "arn:aws:secretsmanager:us-east-1:545095759709:secret:aispend/firecrawl/production-*"
      ]
    },
    {
      "Sid": "RosterLabLogGroupDeployment",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:DescribeLogStreams",
        "logs:ListTagsForResource",
        "logs:PutRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:545095759709:log-group:/aws/lambda/rosterlab-espn-import-*",
        "arn:aws:logs:us-east-1:545095759709:log-group:/aws/apigateway/rosterlab-espn-import-*",
        "arn:aws:logs:us-east-1:545095759709:log-group:/aws/lambda/rosterlab-fantasy-insights-*",
        "arn:aws:logs:us-east-1:545095759709:log-group:/aws/apigateway/rosterlab-fantasy-insights-*",
        "arn:aws:logs:us-east-1:545095759709:log-group:/aws/lambda/aispend-*",
        "arn:aws:logs:us-east-1:545095759709:log-group:/aws/apigateway/aispend-*"
      ]
    },
    {
      "Sid": "RosterLabInsightsDynamoDeployment",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:ListTagsOfResource",
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:UpdateTable",
        "dynamodb:UpdateTimeToLive"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:545095759709:table/rosterlab-fantasy-insights-*",
        "arn:aws:dynamodb:us-east-1:545095759709:table/aispend-*"
      ]
    },
    {
      "Sid": "RosterLabInsightsQueueDeployment",
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue",
        "sqs:DeleteQueue",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListQueueTags",
        "sqs:SetQueueAttributes",
        "sqs:TagQueue",
        "sqs:UntagQueue"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-1:545095759709:rosterlab-fantasy-insights-*",
        "arn:aws:sqs:us-east-1:545095759709:aispend-*"
      ]
    },
    {
      "Sid": "RosterLabDescribeLogGroups",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogGroups"],
      "Resource": "*"
    },
    {
      "Sid": "RosterLabApiLogDelivery",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogDelivery",
        "logs:DeleteLogDelivery",
        "logs:DescribeResourcePolicies",
        "logs:GetLogDelivery",
        "logs:ListLogDeliveries",
        "logs:PutResourcePolicy",
        "logs:UpdateLogDelivery"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RosterLabAlarmDeployment",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DeleteAlarms",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource"
      ],
      "Resource": [
        "arn:aws:cloudwatch:us-east-1:545095759709:alarm:rosterlab-*",
        "arn:aws:cloudwatch:us-east-1:545095759709:alarm:aispend-*"
      ]
    }
  ]
}
